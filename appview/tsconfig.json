{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@types/bun"],
    "noEmit": true,
    "declaration": false,
    "allowImportingTsExtensions": true
  },
  // .cloudflare/types is generated by `cf workers types` from cloudflare.config.ts.
  "include": [
    "src/**/*.ts",
    "cloudflare.config.ts",
    "wrangler.config.ts",
    ".cloudflare/types/index.d.ts"
  ]
}
