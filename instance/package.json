{
  "name": "@igloo/instance",
  "version": "0.1.0",
  "description": "A self-hosted igloo instance: R2 data dirs, public listing, admin panel",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "bun cli/igloo.ts setup",
    "secrets": "bun cli/igloo.ts secrets",
    "dev": "bun scripts/dev.ts",
    "build": "cd web && bun --bun vite build",
    "deploy": "bun run build && bun cli/igloo.ts deploy",
    "deploy:dry": "cf deploy --dry-run",
    "types": "cf workers types",
    "typecheck": "cf workers types && tsc --noEmit",
    "check": "cd web && bun run check",
    "pack": "bun scripts/pack.ts"
  },
  "dependencies": {
    "@igloo/lexicon": "workspace:*",
    "@igloo/platform": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "fetch-to-node": "^2.1.0",
    "hono": "^4.7.0",
    "hyparquet": "1.31.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "cf": "1.0.0-beta.14",
    "hyparquet-writer": "0.16.11",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
