{
  "name": "igloo",
  "version": "0.1.0",
  "description": "A personal data repository you deploy yourself",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "bun scripts/dev.ts",
    "build": "cd web && bun --bun vite build",
    "deploy": "bun run build && bunx wrangler deploy",
    "types": "bunx wrangler types",
    "check": "cd web && bun run check",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "fetch-to-node": "^2.1.0",
    "hono": "^4.7.0",
    "marked": "^15.0.0",
    "svelte": "^5.51.0",
    "vite": "^7.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/bun": "^1.2.0",
    "svelte-check": "^4.3.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "license": "MIT"
}
